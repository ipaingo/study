B8" w:rsidRPr="00C646B8" w:rsidRDefault="00000000" w:rsidP="00DF3443" w14:paraId="6F5A6570"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:spacing w:after="80"/><w:jc w:val="both"/><w:rPr><w:lang w:val="ru-RU"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/><w:lang w:val="ru-RU"/></w:rPr><w:t>сезонность -15%</w:t></w:r></w:p><w:p w:rsidR="00C646B8" w:rsidRPr="00C646B8" w:rsidRDefault="00000000" w:rsidP="00DF3443" w14:paraId="706839B6"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:spacing w:after="80"/><w:jc w:val="both"/><w:rPr><w:lang w:val="ru-RU"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/><w:lang w:val="ru-RU"/></w:rPr><w:t>скидка на самовывоз против политики без демпинга</w:t></w:r></w:p><w:p w:rsidR="00C646B8" w:rsidRPr="00C646B8" w:rsidRDefault="00000000" w:rsidP="00DF3443" w14:paraId="5979E3A2"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:spacing w:after="80"/><w:jc w:val="both"/><w:rPr><w:lang w:val="ru-RU"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/><w:lang w:val="ru-RU"/></w:rPr><w:t>посаженные дедлайны регулятора ПДн и PCI DSS</w:t></w:r></w:p><w:p w:rsidR="00F720CD" w:rsidRPr="00C646B8" w:rsidRDefault="00C646B8" w:rsidP="00DF3443" w14:paraId="501EE450"><w:pPr><w:spacing w:after="80"/><w:ind w:firstLine="284"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t>Были также некоторые расхождения метрик в условии задания с результатами ДЗ 2 (45 минут против 48, 30% против 32%, 1500 руб. против 1400). Я брала цифры из ДЗ 5, ловушки учла в множителях Confidence при расчете RICE, в Risk-Adjusted Impact, в профилях срочности (дедлайны) и в решениях (репилот П15, smoke-тест П9, пилоты П5 и П6).</w:t></w:r></w:p><w:p w:rsidR="00F720CD" w:rsidRPr="00C646B8" w:rsidRDefault="00000000" w:rsidP="00DF3443" w14:paraId="7D88F740"><w:pPr><w:spacing w:before="140" w:after="80"/><w:ind w:firstLine="284"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:lastRenderedPageBreak/><w:t>Сделайте наблюдаемым ход вашей мысли при работе над заданием:</w:t></w:r></w:p><w:p w:rsidR="00F720CD" w:rsidRPr="00C646B8" w:rsidRDefault="00000000" w:rsidP="00DF3443" w14:paraId="1926379A"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="80"/><w:ind w:firstLine="0"/><w:jc w:val="both"/><w:rPr><w:lang w:val="ru-RU"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/><w:lang w:val="ru-RU"/></w:rPr><w:t>Что сработало удачно?</w:t></w:r></w:p><w:p w:rsidR="00F720CD" w:rsidRPr="00C646B8" w:rsidRDefault="002228B1" w:rsidP="00DF3443" w14:paraId="49B1146C"><w:pPr><w:spacing w:after="80"/><w:ind w:firstLine="284"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Нейронка хорошо отловила некоторые мои косяки, например, я один раз поменяла сортировку в табличке с </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/><w:lang w:val="en-US"/></w:rPr><w:t>RICE</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve"> и не вернула обратно, и значения на следующем листе поехали, потому что ссылались на ячейки в этой таблице. Сама я бы не вспомнила об этом, пока не накосячила бы где-нибудь. Еще очень помогла подсказка из Дополнительной информации, хотя это чуть-чуть нечестно, но я заранее знала, что в исходных данных будут ошибки, и надо внимательно за ними следить. Единая лестница доказательств тоже оказалась удобной, одна поправка использована в двух местах – в Confidence (RICE) и в Risk-Adjusted Impact.</w:t></w:r></w:p><w:p w:rsidR="00F720CD" w:rsidRPr="00C646B8" w:rsidRDefault="00000000" w:rsidP="00DF3443" w14:paraId="7F41F470"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="80"/><w:ind w:firstLine="0"/><w:jc w:val="both"/><w:rPr><w:lang w:val="ru-RU"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/><w:lang w:val="ru-RU"/></w:rPr><w:t>С какими сложностями или ошибками столкнулись и как их решали?</w:t></w:r></w:p><w:p w:rsidR="00F720CD" w:rsidRPr="00C646B8" w:rsidRDefault="002228B1" w:rsidP="00DF3443" w14:paraId="70193264"><w:pPr><w:spacing w:after="80"/><w:ind w:firstLine="284"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Очень задолбало все пересчитывать миллион раз. Я знала, что ошибки есть, но не знала, где, и пришлось все перепроверять (все равно косячила, но это решилось ревью второй нейронкой). Опять ограничение по объему отчета – работа очень объемная, а результаты надо впихнуть в пять страниц, и еще чтобы картинка с </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/><w:lang w:val="en-US"/></w:rPr><w:t>I</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t>m</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/><w:lang w:val="en-US"/></w:rPr><w:t>pact</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/><w:lang w:val="en-US"/></w:rPr><w:t>map</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve"> читалась, пришлось оставлять очень куцые формулировки, чтобы влезть в пять страниц. Зато в этот раз без 10 шрифта.</w:t></w:r></w:p><w:p w:rsidR="00F720CD" w:rsidRPr="00C646B8" w:rsidRDefault="00000000" w:rsidP="00DF3443" w14:paraId="6E7E151C"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="80"/><w:ind w:firstLine="0"/><w:jc w:val="both"/><w:rPr><w:lang w:val="ru-RU"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/><w:lang w:val="ru-RU"/></w:rPr><w:t>Использование ИИ: цель, промпты, проверка результатов, ссылки на чаты.</w:t></w:r></w:p><w:p w:rsidR="00F720CD" w:rsidRDefault="002228B1" w:rsidP="00DF3443" w14:paraId="57BBB53A"><w:pPr><w:spacing w:after="80"/><w:ind w:firstLine="284"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Нейронка </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/><w:lang w:val="en-US"/></w:rPr><w:t>Kimi</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve"> 2.8 использовалась для ревью. Я делала эту домашку несколько ночей, и если бы не искусственный читальщик-проверяльщик, результат был бы сомнительным. К счастью, она неплохо находит ошибки, к сожалению, иногда галлюцинирует, поэтому надо все равно вчитываться в то, что она пишет. </w:t></w:r></w:p><w:p w:rsidR="002228B1" w:rsidRPr="00C646B8" w:rsidRDefault="002228B1" w:rsidP="00DF3443" w14:paraId="3A3F4DD2"><w:pPr><w:spacing w:after="80"/><w:ind w:firstLine="284"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t>Ссылка на чат: https://www.kimi.ai/share/1a19b21e-f0c2-8a29-8000-0000082e017c</w:t></w:r></w:p><w:p w:rsidR="00F720CD" w:rsidRPr="00C646B8" w:rsidRDefault="00000000" w:rsidP="00DF3443" w14:paraId="6FC74670"><w:pPr><w:spacing w:before="140" w:after="80"/><w:ind w:firstLine="284"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t>Какая ловушка данных из шага 2 показалась вам самой коварной и почему? Встречали ли вы похожую в жизни (работа, учеба, новости)?</w:t></w:r></w:p><w:p w:rsidR="00F720CD" w:rsidRPr="00C646B8" w:rsidRDefault="00000000" w:rsidP="00DF3443" w14:paraId="4D5B9B50"><w:pPr><w:spacing w:after="80"/><w:ind w:firstLine="284"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t>Самая противная – пилот алгоритма ранжирования (парадокс Симпсона). Суммарная арифметика верна: конверсия действительно выросла с 11.75% до 14.5%, и выводы звучат убедительно, а решение стоит 6 млн руб. Разложение по сегментам показывает, что внутри обоих сегментов конверсия упала на 1 процентный пункт, но это еще надо догадаться проверить. По-хорошему при таких расчетах нужно показывать не только среднее, но и медиану, как с зарплатами.</w:t></w:r></w:p><w:p w:rsidR="00F720CD" w:rsidRPr="00C646B8" w:rsidRDefault="00000000" w:rsidP="00DF3443" w14:paraId="48F53258"><w:pPr><w:spacing w:before="140" w:after="80"/><w:ind w:firstLine="284"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t>Что осталось непонятным или требует уточнения? Укажите вопросы, которые у вас остались по теме задания.</w:t></w:r></w:p><w:p w:rsidR="00F720CD" w:rsidRPr="00C646B8" w:rsidRDefault="008D73F8" w:rsidP="00DF3443" w14:paraId="36F1CBAA"><w:pPr><w:spacing w:after="80"/><w:ind w:firstLine="284"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Я не уверена, как еще аргументировать старт проекта 2 первым, у которого формальный CD3 самый низкий в топ-5, но который разблокирует П1 и закрывает окно скорости. Есть ли методика, которая еще бы оценивала параметр </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/><w:lang w:val="en-US"/></w:rPr><w:t>enabling</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t>-ценности. Второе: как калибровать границы ступеней лестницы доказательств – выбор между 0.2 и 0.3 (мнение команды против косвенных данных) меняет ранжирование, а критерий границы субъективен. Третье: как в RICE оценивать гигиенические проекты с денежным, но не пользовательским эффектом (те же сторис). Шкала Impact его не выражает, но оценивать и обосновывать их как-то нужно. Четвертое: скока можно уже…</w:t></w:r></w:p><w:p w:rsidR="00F720CD" w:rsidRPr="00C646B8" w:rsidRDefault="00000000" w:rsidP="00DF3443" w14:paraId="2B21C4E4"><w:pPr><w:spacing w:before="140" w:after="80"/><w:ind w:firstLine="284"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:bCs/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t>Как ваша работа соответствует критериям оценивания? Самостоятельно оцените, насколько работа соответствует критериям, указанным в задании.</w:t></w:r></w:p><w:p w:rsidR="00F720CD" w:rsidRPr="00C646B8" w:rsidRDefault="00000000" w:rsidP="00DF3443" w14:paraId="38B3D8F2"><w:pPr><w:spacing w:after="80"/><w:ind w:firstLine="284"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t>На мой взгляд, работа соответствует всем критериям задания. RICE рассчитан прозрачно, проведен аудит и найдены ошибки, для каждой прописан механизм и дешевый способ перепроверки. Пилот ранжирования разобран с ручным пересчетом. Корректно сформулированы рамка и карта. Экономика решений: категории 70/20/10/0, множители лестницы доказательств, CD3 для топ-5, найдены шесть инициатив и событий с недефолтным профилем срочности, план реализуем при урезании бюджета на 20%. Итоговая таблица полная, паспорта трех инициатив содержат применимые stop-правила, каждое существенное расхождение с RICE объяснено. Учтены возможные расхождения с R</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/><w:lang w:val="en-US"/></w:rPr><w:t>ICE</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t>.</w:t></w:r></w:p><w:sectPr w:rsidR="00F720CD" w:rsidRPr="00C646B8" w:rsidSect="008D73F8"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1134" w:right="900" w:bottom="1134" w:left="850" w:header="708" w:footer="708" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>